{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arata:schema:aratam-doctor:1",
  "title": "aratam-doctor",
  "description": "aratam doctor --format json の出力。Slack の環境変数 (bot トークンなら auth.test) と LLM の疎通の検査の行。送信はしない",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "aratam-doctor"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "ok": {
      "description": "ng の行が無い (終了コード 0)。warn だけなら true",
      "type": "boolean"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/doctorJSONRow"
      }
    }
  },
  "required": [
    "schema",
    "schema_version",
    "ok",
    "rows"
  ],
  "$defs": {
    "doctorJSONRow": {
      "type": "object",
      "properties": {
        "status": {
          "description": "ng が 1 つでもあれば終了コード 2",
          "type": "string",
          "enum": [
            "ok",
            "warn",
            "ng",
            "skip"
          ]
        },
        "item": {
          "description": "検査した項目 (config / webhook / slack / llm / context)。開いた語彙",
          "type": "string"
        },
        "code": {
          "description": "ログと同じ固定語彙の code (warn・ng の行)",
          "type": "string"
        },
        "detail": {
          "description": "人向けの文。文言は固定しない (機械で読まない)",
          "type": "string"
        }
      },
      "required": [
        "status",
        "item",
        "detail"
      ]
    }
  }
}
