{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arata:schema:config-diff:1",
  "title": "config-diff",
  "description": "arata config init --diff --format json の出力。設定とこの版の雛形の差分の配列 (最上位が配列。schema の項目は無い)",
  "type": "array",
  "items": {
    "$ref": "#/$defs/DiffItem"
  },
  "$defs": {
    "DiffItem": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "current": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path",
        "detail"
      ]
    }
  }
}
