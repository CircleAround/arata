{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arata:schema:report-period:1",
  "title": "report-period",
  "description": "期間レポート (arata report --from --to / --month の report.json。kind: period)",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "report-period"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "period"
    },
    "name": {
      "type": "string"
    },
    "period": {
      "$ref": "#/$defs/Period"
    },
    "generated_at": {
      "type": "string"
    },
    "history_since": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "$ref": "#/$defs/PeriodSummary"
    },
    "events": {
      "$ref": "#/$defs/PeriodEvents"
    },
    "new_principals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PrincipalRow"
      }
    },
    "open": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "metrics": {
      "$ref": "#/$defs/MetricTable"
    },
    "runs_missing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RunProblem"
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProfileRunSum"
      }
    }
  },
  "required": [
    "schema",
    "schema_version",
    "kind",
    "name",
    "period",
    "generated_at",
    "notes",
    "summary",
    "events",
    "new_principals",
    "open",
    "metrics",
    "runs_missing",
    "profiles"
  ],
  "$defs": {
    "EventRow": {
      "type": "object",
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "check": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "summary": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "check",
        "key",
        "severity",
        "summary",
        "at"
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "check": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "first_seen": {
          "type": "string"
        },
        "last_seen": {
          "type": "string"
        },
        "last_changed": {
          "type": "string"
        },
        "reported_at": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "check",
        "key",
        "severity",
        "summary",
        "status",
        "first_seen",
        "last_seen",
        "last_changed",
        "data"
      ]
    },
    "MetricRow": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "date",
        "values"
      ]
    },
    "MetricTable": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MetricRow"
          }
        }
      },
      "required": [
        "metrics",
        "rows"
      ]
    },
    "Period": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "PeriodEvents": {
      "type": "object",
      "properties": {
        "new": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventRow"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventRow"
          }
        },
        "recurred": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventRow"
          }
        },
        "resolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventRow"
          }
        }
      },
      "required": [
        "new",
        "changed",
        "recurred",
        "resolved"
      ]
    },
    "PeriodSummary": {
      "type": "object",
      "properties": {
        "new": {
          "type": "integer"
        },
        "changed": {
          "type": "integer"
        },
        "recurred": {
          "type": "integer"
        },
        "resolved": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "open": {
          "type": "integer"
        }
      },
      "required": [
        "new",
        "changed",
        "recurred",
        "resolved",
        "by_severity",
        "open"
      ]
    },
    "PrincipalRow": {
      "type": "object",
      "properties": {
        "arn": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "first_seen": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "arn",
        "label",
        "kind",
        "first_seen",
        "status"
      ]
    },
    "ProfileRunSum": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string"
        },
        "runs": {
          "type": "integer"
        },
        "ok": {
          "type": "integer"
        },
        "partial": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        }
      },
      "required": [
        "profile",
        "runs",
        "ok",
        "partial",
        "failed"
      ]
    },
    "RunProblem": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "until": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "profile",
        "kind",
        "at"
      ]
    }
  }
}
