{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arata:schema:report:1",
  "title": "report",
  "description": "プロファイル実行の報告 (arata run / evaluate / report の report.json と、標準出力の --format json)。読み方は arata help ai report",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "report"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profile": {
      "type": "string"
    },
    "window": {
      "$ref": "#/$defs/Window"
    },
    "name": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "findings": {
      "$ref": "#/$defs/Findings"
    },
    "already_reported": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "info": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Proposal"
      }
    },
    "dry_run": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "profile",
    "window",
    "name",
    "run_id",
    "generated_at",
    "summary",
    "findings",
    "already_reported",
    "info",
    "coverage"
  ],
  "$defs": {
    "AuthCoverage": {
      "type": "object",
      "properties": {
        "success": {
          "type": "integer"
        },
        "via": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "failure": {
          "type": "integer"
        },
        "reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "impersonate": {
          "type": "integer"
        },
        "invalid": {
          "type": "integer"
        }
      },
      "required": [
        "success",
        "failure",
        "impersonate",
        "invalid"
      ]
    },
    "CollectError": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "partial": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "covered_from": {
          "type": "string"
        },
        "covered_until": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "code",
        "message"
      ]
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "sources_ok": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources_failed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceFailure"
          }
        },
        "checks_run": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks_skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkippedCheck"
          }
        },
        "formats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormatCoverage"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sources_ok",
        "sources_failed",
        "checks_run",
        "checks_skipped",
        "formats"
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "check": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "first_seen": {
          "type": "string"
        },
        "last_seen": {
          "type": "string"
        },
        "last_changed": {
          "type": "string"
        },
        "reported_at": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "check",
        "key",
        "severity",
        "summary",
        "status",
        "first_seen",
        "last_seen",
        "last_changed",
        "data"
      ]
    },
    "Findings": {
      "type": "object",
      "properties": {
        "new": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "recurred": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "resolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "still_open": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        }
      },
      "required": [
        "new",
        "changed",
        "recurred",
        "resolved",
        "still_open"
      ]
    },
    "FormatCoverage": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "log_group": {
          "type": "string"
        },
        "total": {
          "type": "integer"
        },
        "matched": {
          "type": "integer"
        },
        "match_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "expected": {
          "type": "number"
        },
        "recent_average": {
          "type": "number"
        },
        "bytes_scanned": {
          "type": "number"
        },
        "code": {
          "type": "string"
        },
        "truncated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requests": {
          "$ref": "#/$defs/RequestCoverage"
        }
      },
      "required": [
        "source",
        "format",
        "log_group",
        "total",
        "matched",
        "match_rate",
        "expected",
        "bytes_scanned"
      ]
    },
    "Proposal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "about": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "web_acl": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "rule_in_group": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "object"
        },
        "finding_key": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "stage",
        "web_acl",
        "summary",
        "evidence"
      ]
    },
    "RequestCoverage": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer"
        },
        "complete": {
          "type": "integer"
        },
        "complete_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "expected": {
          "type": "number"
        },
        "with_status": {
          "type": "integer"
        },
        "starts": {
          "type": "integer"
        },
        "request_id_reused": {
          "type": "integer"
        },
        "starts_untagged": {
          "type": "integer"
        },
        "users": {
          "$ref": "#/$defs/UserCoverage"
        },
        "auth": {
          "$ref": "#/$defs/AuthCoverage"
        }
      },
      "required": [
        "total",
        "complete",
        "complete_rate",
        "expected",
        "with_status",
        "starts",
        "request_id_reused",
        "starts_untagged"
      ]
    },
    "SkippedCheck": {
      "type": "object",
      "properties": {
        "check": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "check",
        "reason"
      ]
    },
    "SourceFailure": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "partial": {
          "type": "boolean"
        },
        "covered_from": {
          "type": "string"
        },
        "covered_until": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "code"
      ]
    },
    "Summary": {
      "type": "object",
      "properties": {
        "new": {
          "type": "integer"
        },
        "changed": {
          "type": "integer"
        },
        "recurred": {
          "type": "integer"
        },
        "resolved": {
          "type": "integer"
        },
        "still_open": {
          "type": "integer"
        },
        "max_severity": {
          "type": "string",
          "enum": [
            "",
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "collect_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CollectError"
          }
        }
      },
      "required": [
        "new",
        "changed",
        "recurred",
        "resolved",
        "still_open",
        "max_severity",
        "collect_errors"
      ]
    },
    "UserCoverage": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "with_user": {
          "type": "integer"
        },
        "user_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "kinds": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "with_by": {
          "type": "integer"
        },
        "user_id_invalid": {
          "type": "integer"
        }
      },
      "required": [
        "from",
        "with_user",
        "user_rate",
        "with_by",
        "user_id_invalid"
      ]
    },
    "Window": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ]
    }
  }
}
