# 開発用の環境変数の見本。値を入れたものを .env (git の管理外) に置く。値はリポジトリに書かない
# 使うとき: set -a; . ./.env; set +a
#
# aratam の bot トークン (aratam.yaml の slack.bot_token_env の名前に合わせる)
# xoxb- で始まる Bot User OAuth Token。チャンネル ID は秘密ではないので aratam.yaml に書く
ARATAM_SLACK_BOT_TOKEN=
#
# 非推奨 (ADR 0061): Incoming Webhook の方式 (aratam.yaml の slack.webhook_env / urgent_webhook_env の名前に合わせる)。
# 動き続けるが、新しく使わない。bot トークンと両方は使えない
ARATAM_SLACK_WEBHOOK=
ARATAM_SLACK_URGENT_WEBHOOK=
