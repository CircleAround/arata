{
  // 型検査だけに使う (出力しない)。実行は Node の型除去 (Node 22.18 以上) で .ts を直接動かすので、
  // 型除去で消せない構文 (enum・namespace・引数プロパティ) は erasableSyntaxOnly で禁止する。
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
